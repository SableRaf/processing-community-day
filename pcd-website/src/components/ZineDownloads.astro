---
interface Download {
  url: string;
  filename: string;
  fileSize: string;
}

interface Props {
  downloads: Download[];
}

const { downloads } = Astro.props;
---

<div class="downloads">
  <ul class="download-list" aria-label="Downloads">
    {downloads.map((download) => (
      <li class="download-list__item">
        <a
          class="download-list__button"
          href={download.url}
          download={download.filename}
          aria-label={`Download ${download.filename} (${download.fileSize})`}
        >Download</a>
        <span class="download-list__details">
          <span class="download-list__filename">{download.filename}</span>
          <span class="download-list__size">{download.fileSize}</span>
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .download-list {
    display: grid;
    gap: var(--spacing-sm);
    margin: 0 0 var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .download-list__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-sm) var(--spacing-md);
    margin: 0;
  }

  .download-list__details {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-md);
    align-items: baseline;
    min-width: 0;
  }

  .download-list__button {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    color: #fff;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    background: var(--color-primary);
    border-radius: var(--border-radius);
  }

  .download-list__button:hover {
    color: #fff;
    text-decoration: none;
    background: var(--color-primary-dark);
  }

  .download-list__button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .download-list__filename {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-weight: 600;
  }

  .download-list__size {
    color: var(--color-text-muted);
    font-weight: 400;
    white-space: nowrap;
  }
</style>

---
import { Image } from 'astro:assets';
import { PCD_EMAIL, PCD_FORUM_THREAD_URL, PCD_DISCORD_URL, SOCIAL_LINKS } from '../config';
import { SPONSORS } from '../config/sponsors';
import ExternalLinkIcon from './ExternalLinkIcon.astro';

const UTILITY_LINKS = [
  { label: 'Terms & Conditions', href: '/terms/' },
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Trademark', href: '/trademark/' },
  { label: 'Code of Conduct', href: '/organize/code-of-conduct/' },
  { label: 'Contact', href: '/organize/contact/' },
  {
    label: 'Press Kit',
    href: 'https://drive.google.com/drive/folders/13p3OATRze7v5Vwo0TfLsdxTSyc1VOVk_?usp=drive_link',
    external: true,
  },
  {
    label: 'Newsletter',
    href: 'https://processingfoundation.myflodesk.com/newslettersubscription',
    external: true,
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-col footer-col--community">
      <h2>Community</h2>
      <ul>
        <li>
          <a href={PCD_FORUM_THREAD_URL}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            Forum
          </a>
        </li>
        <li>
          <a href={PCD_DISCORD_URL}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 4.9A19.8 19.8 0 0 0 15.4 3.4a.1.1 0 0 0-.1.05c-.2.4-.4.9-.6 1.3a18.3 18.3 0 0 0-5.5 0c-.2-.4-.4-.9-.6-1.3a.1.1 0 0 0-.1-.05A19.7 19.7 0 0 0 3.7 4.9a.07.07 0 0 0 0 .03C.9 9.1.2 13.1.6 17.1a.1.1 0 0 0 .04.06 19.9 19.9 0 0 0 6 3 .1.1 0 0 0 .11-.03c.46-.63.87-1.3 1.22-2a.1.1 0 0 0-.05-.13 13 13 0 0 1-1.86-.9.1.1 0 0 1 0-.16l.37-.29a.1.1 0 0 1 .1-.01 14.2 14.2 0 0 0 12.06 0 .1.1 0 0 1 .1.01l.37.29a.1.1 0 0 1 0 .16c-.6.35-1.22.65-1.87.9a.1.1 0 0 0-.05.13c.36.7.77 1.37 1.22 2a.1.1 0 0 0 .11.03 19.8 19.8 0 0 0 6-3 .1.1 0 0 0 .05-.06c.5-4.6-.63-8.6-2.6-12.17a.06.06 0 0 0-.03-.03zM8.3 14.7c-1.18 0-2.15-1.08-2.15-2.4S7.1 9.9 8.3 9.9c1.2 0 2.17 1.09 2.15 2.4 0 1.32-.95 2.4-2.15 2.4zm7.42 0c-1.18 0-2.15-1.08-2.15-2.4s.95-2.4 2.15-2.4c1.2 0 2.17 1.09 2.15 2.4 0 1.32-.95 2.4-2.15 2.4z"></path></svg>
            Discord
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Sponsors</h2>
      <ul class="sponsor-list">
        {SPONSORS.map((sponsor) => (
          <li>
            <a class="sponsor-logo" href={sponsor.href} aria-label={sponsor.name}>
              <Image src={sponsor.logo} alt={sponsor.name} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="footer-col" aria-label="Site information">
      <h2>More</h2>
      <ul>
        {UTILITY_LINKS.map((link) => (
          <li>
            <a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {link.label}
              {link.external && <ExternalLinkIcon />}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <h2>Follow us</h2>
      <div class="social-row">
        {SOCIAL_LINKS.map((social) => (
          <a href={social.href} aria-label={`Processing on ${social.label}`}>
            {social.label === 'Instagram' && (
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"></circle></svg>
            )}
            {social.label === 'Medium' && (
              <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.4 7.9a.9.9 0 0 0-.3-.75L2.2 4.9V4.6h5.8l4.5 9.9L16.5 4.6H22v.3l-1.6 1.6a.5.5 0 0 0-.2.45v11.4a.5.5 0 0 0 .2.45L22 20.4v.3h-8.1v-.3l1.65-1.63c.16-.16.16-.2.16-.47V9.2l-4.6 11.45h-.62L5.5 9.2v7.68c-.05.36.08.72.33.98l2.15 2.5v.3H2v-.3l2.14-2.5a1.1 1.1 0 0 0 .3-.98V7.9z"></path></svg>
            )}
            {social.label === 'LinkedIn' && (
              <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.1 8.75 21 11.1 21 14.2V21h-4v-6.03c0-1.44-.5-2.42-1.8-2.42-1.36 0-2.2.9-2.2 2.42V21H9z"></path></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="site-footer__base">
    <span>© 2026 Processing Foundation</span>
    <span aria-hidden="true">·</span>
    <a href={`mailto:${PCD_EMAIL}`}>{PCD_EMAIL}</a>
  </div>
</footer>

<style>
  .site-footer {
    flex-shrink: 0;
    border-top: 1px solid var(--color-border);
    background: #fafafa;
    padding: var(--spacing-xl) var(--spacing-md) var(--spacing-lg);
  }

  .site-footer__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(160px, 0.9fr) minmax(180px, 1.1fr) minmax(180px, 1.1fr) minmax(140px, 0.8fr);
    gap: var(--spacing-xl);
  }

  @media (max-width: 860px) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 500px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }

  .footer-col h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-subtle);
    margin: 0 0 var(--spacing-sm);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-col a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .footer-col a svg {
    flex-shrink: 0;
  }

  .footer-col a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-col--community ul {
    gap: var(--spacing-sm);
  }

  .footer-col--community a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .footer-col--community a svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .sponsor-list {
    gap: var(--spacing-sm) !important;
  }

  .sponsor-logo {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #fff;
  }

  .sponsor-logo img {
    display: block;
    width: 200px;
    max-width: 100%;
    height: auto;
  }

  .sponsor-logo:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .social-row {
    display: flex;
    gap: var(--spacing-sm);
  }

  .social-row a {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: #fff;
    color: var(--color-text-muted);
  }

  .social-row a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .site-footer__base {
    max-width: 1120px;
    margin: var(--spacing-xl) auto 0;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-md);
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .site-footer__base a {
    color: var(--color-text-subtle);
  }
</style>

---
import { Image } from 'astro:assets';
import { PCD_EMAIL, PCD_FORUM_THREAD_URL, PCD_DISCORD_URL, SOCIAL_LINKS } from '../config';
import { SPONSORS } from '../config/sponsors';
import Icon from './Icon.astro';

const UTILITY_LINKS = [
  { label: 'Terms & Conditions', href: '/terms/' },
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Trademark', href: '/trademark/' },
  { label: 'Code of Conduct', href: '/organize/code-of-conduct/' },
  { label: 'Contact', href: '/organize/contact/' },
  {
    label: 'Press Kit',
    href: 'https://drive.google.com/drive/folders/13p3OATRze7v5Vwo0TfLsdxTSyc1VOVk_?usp=drive_link',
    external: true,
  },
  {
    label: 'Newsletter',
    href: 'https://processingfoundation.myflodesk.com/newslettersubscription',
    external: true,
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-col footer-col--community">
      <h2>Community</h2>
      <ul>
        <li>
          <a href={PCD_FORUM_THREAD_URL}>
            <Icon name="forum" />
            Forum
          </a>
        </li>
        <li>
          <a href={PCD_DISCORD_URL}>
            <Icon name="discord" />
            Discord
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Sponsors</h2>
      <ul class="sponsor-list">
        {SPONSORS.map((sponsor) => (
          <li>
            <a class="sponsor-logo" href={sponsor.href} aria-label={sponsor.name}>
              <Image src={sponsor.logo} alt={sponsor.name} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="footer-col" aria-label="Site information">
      <h2>More</h2>
      <ul>
        {UTILITY_LINKS.map((link) => (
          <li>
            <a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {link.label}
              {link.external && <Icon name="external-link" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <h2>Follow us</h2>
      <div class="social-row">
        {SOCIAL_LINKS.map((social) => (
          <a href={social.href} aria-label={`Processing on ${social.label}`}>
            <Icon name={social.label.toLowerCase()} />
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="site-footer__base">
    <span>© 2026 Processing Foundation</span>
    <span aria-hidden="true">·</span>
    <a href={`mailto:${PCD_EMAIL}`}>{PCD_EMAIL}</a>
  </div>
</footer>

<style>
  .site-footer {
    flex-shrink: 0;
    border-top: 1px solid var(--color-border);
    background: #fafafa;
    padding: var(--spacing-xl) var(--spacing-md) var(--spacing-lg);
  }

  .site-footer__inner {
    max-width: 1120px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(160px, 0.9fr) minmax(180px, 1.1fr) minmax(180px, 1.1fr) minmax(140px, 0.8fr);
    gap: var(--spacing-xl);
  }

  @media (max-width: 860px) {
    .site-footer__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-lg);
    }
  }

  @media (max-width: 500px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-lg);
    }
  }

  .footer-col h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-text-subtle);
    margin: 0 0 var(--spacing-sm);
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .footer-col a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .footer-col a :global(svg) {
    flex-shrink: 0;
  }

  .footer-col a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-col--community ul {
    gap: var(--spacing-sm);
  }

  .footer-col--community a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .footer-col--community a :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .sponsor-list {
    gap: var(--spacing-sm) !important;
  }

  .sponsor-logo {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #fff;
  }

  .sponsor-logo img {
    display: block;
    width: 200px;
    max-width: 100%;
    height: auto;
  }

  .sponsor-logo:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .social-row {
    display: flex;
    gap: var(--spacing-sm);
  }

  .social-row a {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: #fff;
    color: var(--color-text-muted);
  }

  .social-row a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .site-footer__base {
    max-width: 1120px;
    margin: var(--spacing-xl) auto 0;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm) var(--spacing-md);
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .site-footer__base a {
    color: var(--color-text-subtle);
  }
</style>

---
import Icon from './Icon.astro';
import ShareMenu from './ShareMenu.vue';
import '../styles/docs/tokens.css';
import '../styles/docs/components.css';

interface Props {
  markdown: string;
  permalink: string;
  editHref: string;
}

const { markdown, permalink, editHref } = Astro.props;
---

<div class="docs-page-actions">
  <ShareMenu markdown={markdown} permalink={permalink} client:load />

  <a
    class="docs-action-button"
    href={editHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Edit on GitHub (opens in a new tab)"
  >
    <Icon name="github" />
    <span>Edit on GitHub</span>
  </a>
</div>

---
import { Image } from 'astro:assets';
import { ACTIVITY_GUIDE_SUBMIT_URL, activityGuideSubmitUrl } from '../config';
import { loadZineCards } from '../lib/zines';
import ExternalLinkIcon from './ExternalLinkIcon.astro';

const cards = await loadZineCards();
---

<ul class="guide-grid">
  {cards.map((card) => {
    return card.placeholder ? (
      <li>
        <div class="guide-card guide-card--empty">
          <span class="guide-card__empty-title"><strong>{card.title}</strong></span>
          <a
            class="guide-card__submit"
            href={activityGuideSubmitUrl(card.title)}
            target="_blank"
            rel="noopener noreferrer"
          >
            Submit a zine <ExternalLinkIcon />
          </a>
        </div>
      </li>
    ) : (
      <li>
        <a class="guide-card guide-card--zine" href={card.href}>
          {card.cover
            ? <Image src={card.cover} alt="" />
          : <span class="guide-card__cover-placeholder" aria-hidden="true">{card.title}</span>}
        <span class="guide-card__body">
          <strong>{card.title}</strong>
          <span class="guide-card__summary">{card.summary}</span>
        </span>
        </a>
      </li>
    );
  })}
  <li>
    <a class="guide-card guide-card--add" href={ACTIVITY_GUIDE_SUBMIT_URL} target="_blank" rel="noopener noreferrer">
      <span class="guide-card__plus" aria-hidden="true">+</span>
      <span>Submit a guide</span>
      <ExternalLinkIcon />
    </a>
  </li>
</ul>

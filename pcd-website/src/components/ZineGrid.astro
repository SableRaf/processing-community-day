---
import { Image } from 'astro:assets';
import { ACTIVITY_GUIDE_SUBMIT_URL } from '../config';
import { loadZines } from '../lib/zines';

const zines = await loadZines();
---

<ul class="guide-grid">
  {zines.map((zine) => (
    <li>
      <a class="guide-card guide-card--zine" href={zine.href}>
        <span class="guide-card__cover-frame">
          {zine.cover
            ? <Image src={zine.cover.src} alt={zine.cover.alt} />
            : <span class="guide-card__cover-placeholder" aria-hidden="true">{zine.title}</span>}
        </span>
        <span class="guide-card__body">
          <strong>{zine.title}</strong>
          <span class="guide-card__author">by {zine.created_by}</span>
        </span>
      </a>
    </li>
  ))}
  <li>
    <a class="guide-card guide-card--add" href={ACTIVITY_GUIDE_SUBMIT_URL} target="_blank" rel="noopener noreferrer">
      <svg class="guide-card__plus" aria-hidden="true" viewBox="0 0 16 16">
        <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0Zm1.062 4.312a1 1 0 1 0-2 0v2.75h-2.75a1 1 0 0 0 0 2h2.75v2.75a1 1 0 1 0 2 0v-2.75h2.75a1 1 0 1 0 0-2h-2.75Z"></path>
      </svg>
      <span>Submit a Zine</span>
    </a>
  </li>
</ul>

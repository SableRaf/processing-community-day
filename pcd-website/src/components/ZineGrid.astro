---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import { ZINE_SUBMIT_URL } from '../config';
import { loadZines } from '../lib/zines';

const zines = await loadZines();
---

<ul class="guide-grid">
  {zines.map((zine) => (
    <li>
      <a class="guide-card guide-card--zine" href={zine.href}>
        <span class="guide-card__cover-frame">
          {zine.cover
            ? <Image
                src={zine.cover.src}
                alt={zine.cover.alt}
                width={420}
                height={594}
                layout="constrained"
                fit="cover"
              />
            : <span class="guide-card__cover-placeholder" aria-hidden="true">{zine.title}</span>}
        </span>
        <span class="guide-card__body">
          <strong>{zine.title}</strong>
          <span class="guide-card__author">by {zine.created_by}</span>
        </span>
      </a>
    </li>
  ))}
  <li>
    <a class="guide-card guide-card--add" href={ZINE_SUBMIT_URL} target="_blank" rel="noopener noreferrer" data-submit-zine>
      <Icon name="plus-circle" class="guide-card__plus" />
      <span>Submit a Zine</span>
    </a>
  </li>
</ul>

<script>
  import { trackEvent, SUBMIT_ZINE_BUTTON_CLICK } from '../lib/analytics';

  document.querySelectorAll('[data-submit-zine]').forEach((link) => {
    link.addEventListener('click', () => trackEvent(SUBMIT_ZINE_BUTTON_CLICK));
  });
</script>

---
import { NAV_ITEMS } from '../config/navigation';

const normalize = (pathname: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const stripped = base && pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
  return stripped.endsWith('/') || stripped === '' ? stripped : `${stripped}/`;
};

const currentPath = normalize(Astro.url.pathname);
---

<header data-site-header>
  <a class="logo" href="/">Processing Community Day</a>
  <nav aria-label="Main">
    <ul>
      {NAV_ITEMS.map((item) => {
        const isCurrent = normalize(item.href) === currentPath;
        return (
          <li>
            <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-controls);
    background-color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: 0 var(--spacing-lg);
  }

  .logo {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    font-size: 1rem;
  }

  .logo:hover {
    text-decoration: underline;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding: var(--spacing-xs) 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    border-bottom-color: rgba(255, 255, 255, 0.6);
  }

  nav a[aria-current='page'] {
    border-bottom-color: #fff;
  }

  @media (max-width: 480px) {
    .logo {
      font-size: 0.875rem;
    }

    nav ul {
      gap: var(--spacing-md);
    }

    nav a {
      font-size: 0.8125rem;
    }
  }
</style>

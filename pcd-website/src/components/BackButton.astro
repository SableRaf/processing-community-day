---
import Icon from './Icon.astro';
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Back' } = Astro.props;
---

<a class="back-button" href={href}>
  <Icon name="chevron-left" class="back-button__icon" />
  {label}
</a>

<style>
  .back-button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-lg);
    color: var(--color-link);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .back-button:hover {
    color: var(--color-primary-dark);
    text-decoration-color: var(--color-link-underline-hover);
  }

  /* :global because <Icon> injects the svg via set:html, so it doesn't get
     this component's scoping attribute. */
  .back-button :global(.back-button__icon) {
    flex: 0 0 auto;
    fill: currentColor;
  }

  @media (min-width: 31.25rem) {
    .back-button {
      font-size: 1.125rem;
    }
  }

</style>

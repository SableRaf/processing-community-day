---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing pages/about content entry');
const { Content } = await render(entry);
---

<SiteLayout
  title="What is PCD? — Processing Community Day"
  description="Processing Community Day is a global network of community-led events celebrating creative coding and the open-source tools behind it."
>
  <div class="prose">
    <p class="prose__eyebrow">About</p>
    <h1>{entry.data.title}</h1>
    <Content />
  </div>
</SiteLayout>

---
import { Image } from 'astro:assets';
import { render, type GetStaticPaths } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BackButton from '../../components/BackButton.astro';
import DocsPageActions from '../../components/DocsPageActions.astro';
import ZineDownloads from '../../components/ZineDownloads.astro';
import { formatDate } from '../../lib/format';
import { LICENSE_URLS } from '../../lib/zine-metadata.js';
import { loadZines, type Zine } from '../../lib/zines';

export const getStaticPaths: GetStaticPaths = async () => {
  const zines = await loadZines();
  return zines.map((zine) => ({ params: { id: zine.id }, props: { zine } }));
};

const { zine } = Astro.props as { zine: Zine };
const { Content } = await render(zine.entry);
const permalink = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const editHref = `https://github.com/processing/processing-community-day/edit/main/pcd-website/src/content/zines/${zine.id}/index.md`;
const issueHref = `https://github.com/processing/processing-community-day/issues/${zine.intake.issue_number}`;
const submitterHref = `https://github.com/${zine.intake.submitted_by_github}`;
const creator = zine.created_by_url
  ? `[${zine.created_by}](${zine.created_by_url})`
  : zine.created_by;
const markdown = `# ${zine.title}\n\nby ${creator}\n\n${zine.entry.body?.trim() ?? ''}`;
---

<SiteLayout title={`${zine.title} — Processing Community Day`} description={zine.summary}>
  <article class="prose activity-guide">
    <div class="activity-guide__actions">
      <BackButton href="/organize/activity-guides/zine-library/" label="Back to Zine Library" />
      <div class="activity-guide__page-actions">
        <DocsPageActions markdown={markdown} permalink={permalink} editHref={editHref} />
      </div>
    </div>

    <div class="activity-guide__layout">
      <div class="activity-guide__intro">
        <h1>{zine.title}</h1>
        <p class:list={['activity-guide__author', { 'activity-guide__author--with-tags': zine.tags }]}>
          by {zine.created_by_url
            ? <a href={zine.created_by_url} target="_blank" rel="noopener noreferrer">{zine.created_by}</a>
            : zine.created_by}
        </p>
        {zine.tags && (
          <ul class="activity-guide__tags" aria-label="Tags">
            {zine.tags.map((tag) => <li class="activity-guide__tag">{tag}</li>)}
          </ul>
        )}
      </div>

      <div class="activity-guide__sidebar">
        {zine.cover
          ? <Image class="activity-guide__cover" src={zine.cover.src} alt={zine.cover.alt} />
          : <div class="activity-guide__cover activity-guide__cover--placeholder" aria-hidden="true">{zine.title}</div>}
      </div>

      <div class="activity-guide__details">
        <Content />

        <hr />

        <ZineDownloads downloads={zine.downloads} />

        <hr />

        <section class="activity-guide__metadata" aria-label="Details">
          <dl>
            {zine.activity_type && <div><dt>Activity type:</dt><dd>{zine.activity_type}</dd></div>}
            {zine.duration && <div><dt>Duration:</dt><dd>{zine.duration}</dd></div>}
            {zine.materials && <div><dt>Required materials:</dt><dd>{zine.materials}</dd></div>}
            <div><dt>Topic:</dt><dd>{zine.topic}</dd></div>
            {zine.zine_format && <div><dt>Zine format:</dt><dd>{zine.zine_format}</dd></div>}
            {zine.license && (
              <div>
                <dt>License:</dt>
                <dd><a href={LICENSE_URLS[zine.license]}>{zine.license}</a></dd>
              </div>
            )}
            {zine.attribution && <div><dt>Attribution:</dt><dd>{zine.attribution}</dd></div>}
            <div>
              <dt>Submitted:</dt>
              <dd>
                <a href={issueHref} target="_blank" rel="noopener noreferrer">
                  <time datetime={zine.intake.submitted_date}>{formatDate(zine.intake.submitted_date)}</time>
                </a>
              </dd>
            </div>
            <div>
              <dt>Submitted by:</dt>
              <dd><a href={submitterHref} target="_blank" rel="noopener noreferrer">{zine.intake.submitted_by_github}</a></dd>
            </div>
          </dl>
        </section>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .activity-guide {
    max-width: 72rem;
  }

  .activity-guide__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: var(--spacing-xl);
  }

  .activity-guide__layout {
    display: grid;
    gap: 0;
  }

  .activity-guide__intro,
  .activity-guide__details {
    min-width: 0;
  }

  .activity-guide__intro h1 {
    margin-bottom: var(--spacing-xs);
  }

  .activity-guide__sidebar {
    margin-bottom: var(--spacing-xl);
  }

  .activity-guide__cover {
    display: block;
    width: 100%;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
  }

  .activity-guide__cover--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: var(--spacing-lg);
    color: var(--color-text-subtle);
    font-size: clamp(1.5rem, 5vw, 3rem);
    font-weight: 600;
    text-align: center;
    background: var(--color-border);
  }

  .activity-guide__author {
    margin: 0 0 var(--spacing-lg);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .activity-guide__author--with-tags {
    margin-bottom: var(--spacing-md);
  }

  .activity-guide__metadata dl {
    display: grid;
    gap: var(--spacing-sm);
    margin: 0;
  }

  .activity-guide__metadata dl > div {
    display: block;
  }

  .activity-guide__metadata dt {
    display: inline;
    margin-right: 0.25em;
    color: var(--color-text-subtle);
    font-weight: 600;
  }

  .activity-guide__metadata dd {
    display: inline;
    margin: 0;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .activity-guide__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin: 0 0 var(--spacing-lg);
    padding: 0;
    list-style: none;
  }

  .activity-guide__tag {
    margin: 0;
    padding: 0.25rem 0.625rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.25;
    background: var(--color-bg-popup-hover);
    border-radius: 0.25rem;
  }

  @media (min-width: 50rem) {
    .activity-guide__actions {
      flex-flow: row wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--spacing-sm) var(--spacing-lg);
      margin-bottom: 0;
    }

    .activity-guide__page-actions {
      margin-left: auto;
    }

    .activity-guide__layout {
      grid-template-columns: minmax(16rem, 2fr) minmax(0, 3fr);
      grid-template-rows: auto auto;
      column-gap: var(--spacing-xl);
      align-items: start;
    }

    .activity-guide__intro {
      grid-column: 2;
      grid-row: 1;
    }

    .activity-guide__sidebar {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-bottom: 0;
    }

    .activity-guide__details {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>

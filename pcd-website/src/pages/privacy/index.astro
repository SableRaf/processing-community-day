---
import { getEntry, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const entry = await getEntry('legal', 'privacy-policy');
if (!entry) throw new Error('Missing legal/privacy-policy content entry');
const { Content } = await render(entry);
---

<SiteLayout title={`${entry.data.title} — Processing Community Day`} description="How day.processing.org handles your data.">
  <div class="prose">
    <p class="prose__eyebrow">Legal</p>
    <h1>{entry.data.title}</h1>
    <Content />
  </div>
</SiteLayout>

---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { flattenKitNav, getKitNav } from '../../config/organizer-kit-nav';
import { ACTIVITY_GUIDE_SUBMIT_URL } from '../../config';
import ZineGrid from '../../components/ZineGrid.astro';
import ZineSubmitButton from '../../components/ZineSubmitButton.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('organizerKit', (entry) => !entry.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Prev/next follow the sidebar's reading order rather than the raw collection
// order, so they match what the reader sees in the nav.
const nav = await getKitNav();
const ordered = flattenKitNav(nav);
const position = ordered.findIndex((page) => page.id === entry.id);
const prev = position > 0 ? ordered[position - 1] : undefined;
const next = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined;

const editHref = `https://github.com/processing/processing-community-day/edit/main/pcd-website/src/content/organizer-kit/${entry.id}.md`;
const SUBMIT_PAGES = new Set(['activity-guides/zine-library', 'activity-guides/contribute-a-guide']);
const markdownSuffix = SUBMIT_PAGES.has(entry.id)
  ? `\n\n[Submit an activity guide](${ACTIVITY_GUIDE_SUBMIT_URL})\n`
  : '';
const markdown = `# ${entry.data.title}\n\n${entry.body?.trim() ?? ''}\n${markdownSuffix}`;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description ?? `${entry.data.title} — the Processing Community Day Organizer's Kit.`}
  eyebrow={entry.data.section ?? "Organizer's Kit"}
  headings={headings}
  markdown={markdown}
  editHref={editHref}
>
  <Content />
  {entry.id === 'activity-guides/zine-library' && <ZineGrid />}
  {entry.id === 'activity-guides/contribute-a-guide' && <ZineSubmitButton />}

  <a class="docs-back-to-top" href="#main">
    <svg class="docs-back-to-top__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
      <path d="M3.47 7.78a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0l4.25 4.25a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018L9 4.81v7.44a.75.75 0 0 1-1.5 0V4.81L4.53 7.78a.75.75 0 0 1-1.06 0Z" />
    </svg>
    Back to top
  </a>

  {(prev || next) && (
    <nav class="docs-pager" aria-label="Organizer Kit pages">
      {prev ? (
        <a class="docs-pager__link docs-pager__link--prev" href={prev.href}>
          <span class="docs-pager__label">Previous</span>
          <span class="docs-pager__title">{prev.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="docs-pager__link docs-pager__link--next" href={next.href}>
          <span class="docs-pager__label">Next</span>
          <span class="docs-pager__title">{next.title}</span>
        </a>
      )}
    </nav>
  )}

  <p class="docs-page-credit">
    Theme adapted from <a
      href="https://github.com/just-the-docs/just-the-docs"
      target="_blank"
      rel="noopener noreferrer">Just the Docs</a
    >, used under the MIT License.
  </p>
</DocsLayout>

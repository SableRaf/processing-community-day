---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getKitNav } from '../../config/organizer-kit-nav';

const nav = await getKitNav();
const markdownContents = nav
  .map((node) => {
    if (node.kind === 'page') return `- [${node.page.title}](${node.page.href})`;
    const pages = node.pages.map((page) => `  - [${page.title}](${page.href})`).join('\n');
    return `- **${node.title}**\n${pages}`;
  })
  .join('\n');
const markdown = `# Organizer's Kit

Thank you for registering to organize Processing Community Day. We understand that it can take enormous physical and emotional effort to organize a community event, therefore we have compiled this Organizer's Kit to help you get things started.

Think of it as an inspiration rather than a set of instructions to follow like a rule book. If this is your first time, start with the [Minimum Viable PCD](/organize/getting-started/minimum-viable-pcd/).

## Contents

${markdownContents}

Except where otherwise specified, this kit is licensed under a [Creative Commons Attribution-ShareAlike 4.0 International License](https://creativecommons.org/licenses/by-sa/4.0/).
`;
const editHref = 'https://github.com/processing/processing-community-day/edit/main/pcd-website/src/pages/organize/index.astro';
---

<DocsLayout
  title="PCD Organizer's Kit"
  heading="PCD Organizer's Kit"
  description="Everything you need to organize a Processing Community Day in your city, from the simplest possible event to a full day of workshops and talks."
  eyebrow="Organize"
  markdown={markdown}
  editHref={editHref}
>
  <p class="lead">
    Thank you for registering to organize Processing Community Day. We understand that it can take
    enormous physical and emotional effort to organize a community event, therefore we have compiled
    this Organizer's Kit to help you get things started.
  </p>

  <p>
    Think of it as an inspiration rather than a set of instructions to follow like a rule book. If
    this is your first time, start with the <a href="/organize/getting-started/minimum-viable-pcd/"
      >Minimum Viable PCD</a
    >.
  </p>

  <h2 id="contents">Contents</h2>

  <ul class="docs-toc">
    {nav.map((node) =>
      node.kind === 'page' ? (
        <li><a href={node.page.href}>{node.page.title}</a></li>
      ) : (
        <li>
          <span class="docs-toc__group">{node.title}</span>
          <ul>
            {node.pages.map((page) => (
              <li><a href={page.href}>{page.title}</a></li>
            ))}
          </ul>
        </li>
      ),
    )}
  </ul>

  <div class="callout">
    <p>
      Except where otherwise specified, this kit is licensed under a
      <a href="https://creativecommons.org/licenses/by-sa/4.0/"
        >Creative Commons Attribution-ShareAlike 4.0 International License</a
      >.
    </p>
  </div>
</DocsLayout>

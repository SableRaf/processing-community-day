---
import { loadNodes } from '../lib/nodes';
import MapView from '../components/MapView.vue';
import MapLayout from '../layouts/MapLayout.astro';
import { getImage } from 'astro:assets';
import ogImageSrc from '../images/PCD2026_og-image_tinyfied.png';

const nodes = await loadNodes();

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bannerImage = await getImage({ src: ogImageSrc, format: 'webp', quality: 80, width: 960 });
const ogImageUrl = `${siteUrl}${base}/og-image.png`;
---

<MapLayout
  title="Processing Community Day 2026"
  description="Processing Community Day 2026 | Discover the global celebration of creativity and coding! Explore events worldwide, connect with local communities, and join the fun. Find an event near you or start your own PCD today!"
  ogTitle="Processing Community Day 2026 | Join the global celebration of creativity and coding!"
  ogDescription="Explore events worldwide, connect with local communities, and join the fun. Find an event near you or start your own PCD today!"
  ogImage={ogImageUrl}
>
  <a href="#main" class="skip-link" id="skip-link">Skip to map</a>
  <MapView nodes={nodes} bannerImageUrl={bannerImage.src} client:only="vue" />
</MapLayout>

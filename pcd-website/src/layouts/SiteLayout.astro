---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import '../styles/base.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, ogImage, canonical, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonical={canonical} noindex={noindex} bodyClass="site-body">
  <Header />
  <main id="main" tabindex="-1">
    <slot />
  </main>
</BaseLayout>

<style is:global>
  .site-body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .site-body main {
    flex: 1;
    padding-top: var(--header-height);
  }
</style>
